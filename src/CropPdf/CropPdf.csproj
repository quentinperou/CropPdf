<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 2004 SDK projection gives access to Windows.Data.Pdf (built-in PDF renderer). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CropPdf</AssemblyName>
    <RootNamespace>CropPdf</RootNamespace>
    <ApplicationIcon>Assets\CropPdf.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Crop PDF</Product>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <!-- Application.ThemeMode (Windows 11 Fluent theme) is still flagged as experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\CropPdf.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CropPdf.Core\CropPdf.Core.csproj" />
  </ItemGroup>

</Project>
